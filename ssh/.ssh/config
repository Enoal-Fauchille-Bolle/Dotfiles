# Private hosts stay out of this public repository: ~/.ssh/config.d/ is restored
# from the restic backup. Before the first Host block, or it would only apply to it.
Include config.d/*

# Bypass corporate firewall by using port 443 for GitHub
Host github.com
    Hostname ssh.github.com
    Port 443
    User git
    IdentityFile ~/.ssh/id_ed25519
