{
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "0.25"
  },
  "model": "sonnet",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude-notifier-on-permission.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__plugin_desktop-commander_desktop-commander__(start_process|interact_with_process)",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_input.command // .tool_input.input // empty\" | grep -qE \"(^|[;&|(]|then|do)[[:space:]]*git([[:space:]]+(-[cC][[:space:]]+[^[:space:]]+|--[[:alnum:]-]+(=[^[:space:]]+)?|-[[:alpha:]]))*[[:space:]]+push([^[:alnum:]_-]|$)\" && { echo \"Blocked: git push is forbidden, only Enoal pushes.\" >&2; exit 2; } || exit 0"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude-notifier-on-question.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude-notifier-on-stop.js\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude-notifier-on-subagent-stop.js\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude-notifier-on-prompt.js\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/claude-usage\" guard || exit 1"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "gitlab@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "claude-code-wakatime@wakatime": true,
    "code-review@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": true,
    "atlassian-mcp@anthropic-plugin-directory": true,
    "brightdata-plugin@synced": false,
    "productivity@synced": false,
    "product-management@synced": false,
    "engineering@synced": false,
    "design@synced": false,
    "cowork-plugin-management@synced": false,
    "pdf-viewer@synced": false
  },
  "extraKnownMarketplaces": {
    "wakatime": {
      "source": {
        "source": "git",
        "url": "https://github.com/wakatime/claude-code-wakatime.git"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "syntaxHighlightingDisabled": false,
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "tui": "fullscreen",
  "timeFormat": "24-hour",
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true,
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  }
}
