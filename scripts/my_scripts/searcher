            print(f"{Fore.GREEN}Fichier: {fichier}:{num_ligne}{Style.RESET_ALL}")
            print(f"{Fore.BLUE}{ligne_formattee}{Style.RESET_ALL}\n")
    else:
        print("Aucun fichier ne contient le mot clé.")

if __name__ == "__main__":
    if len(sys.argv) != 3:
        print("Usage: searcher <dossier> <mot_clé>")
        sys.exit(1)

    dossier_a_explorer = sys.argv[1]
    mot_cle_recherche = sys.argv[2]

    if not os.path.isdir(dossier_a_explorer):
        print("Le chemin spécifié n'est pas un dossier valide.")
        sys.exit(1)

    resultats = chercher_mots_cles(dossier_a_explorer, mot_cle_recherche)
    afficher_resultats(resultats)
