#!/usr/bin/env python3

import os
import re
import sys
from colorama import Fore, Style

# Installation de colorama : pip install colorama

def chercher_mots_cles(dossier, mot_cle):
    fichiers_trouves = []
    for racine, sous_dossiers, fichiers in os.walk(dossier):
        for fichier in fichiers:
            chemin_fichier = os.path.join(racine, fichier)
            try:
                with open(chemin_fichier, 'r', encoding='utf-8') as f:
                    for num_ligne, ligne in enumerate(f, start=1):
                        if re.search(mot_cle, ligne):
                            fichiers_trouves.append((chemin_fichier, num_ligne, ligne.strip()))
            except (UnicodeDecodeError, PermissionError):
                # Ignorer les fichiers qui ne peuvent pas être lus ou accédés
                pass
    return fichiers_trouves

